# ========================================================
# TalkApp Configuration Environment Variables
# Copy this file to .env and adjust values for your server
# ========================================================

# Server Port (Default: 3000)
PORT=3000

# Server Domain or Public IP (e.g. talkapp.example.com or 192.168.1.100)
SERVER_DOMAIN=localhost
PUBLIC_IP=127.0.0.1

# Node Environment (production / development)
NODE_ENV=production

# Initial Admin Account Password (Set this before first boot, or change it in Settings)
ADMIN_DEFAULT_PASSWORD=admin123

# WebRTC Coturn Relay Configuration (STUN / TURN)
# TURN_URL=turn:localhost:3478
# TURN_USERNAME=talkapp
# TURN_CREDENTIAL=change_this_turn_secret_password
